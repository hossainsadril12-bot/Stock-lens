# .claude/ is intentionally tracked so the workspace is portable across machines
# (settings.local.json = permission allowlist only, no secrets)

# dependencies / build output (development/ has its own too)
**/node_modules/
**/.next/
**/out/
**/build/

# local database (regenerate with: npm run db:seed)
*.db
*.db-journal
*.db-wal
*.db-shm

# env files with local secrets
**/.env*.local

# logs / scratch
*.log

# OS
.DS_Store
Thumbs.db
