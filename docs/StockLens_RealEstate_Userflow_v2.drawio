        <mxCell id="p4e4" value="Deal Won" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="p4_res" target="p4_sold"><mxGeometry relative="1" as="geometry" /></mxCell>
