        <mxCell id="p1_gate" value="Item-type gate: What do you track?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="290" y="470" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="p1_pick" value="Owner ticks Real Estate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="580" width="180" height="40" as="geometry" /></mxCell>
        <mxCell id="p1_reshape" value="Sidebar reshapes to real-estate menus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="280" y="670" width="220" height="50" as="geometry" /></mxCell>
