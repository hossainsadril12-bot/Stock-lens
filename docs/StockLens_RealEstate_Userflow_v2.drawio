        <mxCell id="p1_cimp" value="Confirm import" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="70" y="1055" width="160" height="40" as="geometry" /></mxCell>
