        <mxCell id="p2_appr" value="Approvals waiting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="780" y="170" width="160" height="40" as="geometry" /></mxCell>
