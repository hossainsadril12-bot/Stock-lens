        <mxCell id="p1_title" value="Page 1 — Onboarding and Setup (owner, first time)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="600" height="30" as="geometry" /></mxCell>

